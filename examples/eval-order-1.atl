;; The arguments to the `+` call should be evaluated from left to
;; right.

;; We modify the literal evaluation part of the interpreter to print
;; the expression before evaluating it. This prints the arguments in
;; the order they're evaluated before returning the answer.

;; 11
;; 7
;; 24
;; => 42

(bind (*i* (replace-marker
            *i* :atl/literal
            (qu (:atl/printing-literal (second (list (prn e) e))))))

      (+ 11 7 24))
