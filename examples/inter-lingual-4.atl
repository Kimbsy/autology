;; Basic addition using multiple languages all together.

(+

 (with-*i* :scheme
   (define (double x) (* x 2))
   (double 21)
   )

 (with-*i* :python
   import numpy as np
   
   arr = np.array([6, 7])
   return np.prod(arr)
   )

 (with-*i* :c
   printf("Hello World!\n");
   
   int x = 0;
   for (int i = 13; i < 16; i++) {
     x += i;
   }
   
   return x;
   )

 )
