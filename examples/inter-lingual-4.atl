;; Basic addition using multiple languages all together.

(+

 (with-*i* autology.interpreters.scheme/evaluate
   (define (double x) (* x 2))
   (double 21)
   )

 (with-*i* autology.interpreters.python/evaluate
   import numpy as np
   
   arr = np.array([6, 7])
   return np.prod(arr)
   )

 (with-*i* autology.interpreters.c/evaluate
   printf("Hello World!\n");
   
   int x = 0;
   for (int i = 13; i < 16; i++) {
     x = x + i;
   }
   
   return x;
   )

 )
