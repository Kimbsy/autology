;; The arguments to the `+` call would normally be evaluated from left
;; to right, but we replace the function application part of the
;; interpreter with a version which reverses the argument list before
;; evaluating them and then re-reverses the evaluated arguments before
;; invoking the function (so that non-commutative operations like
;; division work the same).

;; Our literal-printing interpreter modification will once again print
;; the arguments in the order they're evaluated, in this case from
;; right to left, before returning the answer.

;; 39
;; 2
;; 1
;; => 42

(bind (*i* (replace-marker
            *i* :atl/function-application
            (qu (:atl/reverse-order-application
                 (->> (rest e)
                      reverse
                      (map (fn [arg] (evaluate arg env)))
                      reverse
                      (apply (evaluate (first e)))))))
       *i* (replace-marker
            *i* :atl/literal
            (qu (:atl/printing-literal (second (list (prn e) e))))))

      (+ 1 2 39))
